<!DOCTYPE html>
<html dir="ltr" lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/matrix-admin/assets/images/favicon.png">
    <title>@ViewData["Title"] - Admin Panel</title>

    <!-- Custom CSS -->
    <link href="~/matrix-admin/assets/libs/flot/css/float-chart.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="~/matrix-admin/dist/css/style.min.css" rel="stylesheet">

    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
        <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->
    <!-- DataTables CSS -->
    <!-- eklendi -->
    <!-- FIX: Matrix Admin Bootstrap 4 tabanlı olduğu için DT’nin Bootstrap 4 temasına sabitliyoruz -->
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

    <style>
        /* ========= KÜTÜPHANE PALETİ (örnek sayfayla aynı) ========= */
        :root {
            --accent: #8b5cf6;
            --accent-600: #7c3aed;
            --ink: #0f172a;
            --muted: #64748b;
            --card: #ffffff;
            --soft: #f8fafc;
            --thead: #0b1220;
            --thead-text: #fff;
            --row-hover: #f8fafc;
            /* FIX: sidebar genişlikleri (açık/mini) */
            --sidebar-open: 240px;
            --sidebar-mini: 72px;
        }

        /* ========= Topbar ========= */
        .topbar {
            background: #fff !important;
            box-shadow: 0 4px 16px rgba(2,6,23,.06);
            transition: background-color .25s ease, box-shadow .25s ease;
        }

            /* FIX: navbar-dark -> light görünüm; metinler görünür olsun */
            .topbar .navbar {
                background: transparent !important;
            }

        .navbar-light .navbar-nav .nav-link,
        .navbar-light .navbar-brand,
        .navbar-light .navbar-nav .nav-link i {
            color: var(--ink) !important;
        }

            .navbar-light .navbar-nav .nav-link:hover {
                color: var(--accent-600) !important;
            }

        /* Dropdown görünürlük */
        .topbar .dropdown-menu {
            border: 0;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(2,6,23,.12);
        }

        .topbar .dropdown-item {
            color: var(--ink);
        }

            .topbar .dropdown-item:hover {
                background: rgba(2,6,23,.04);
            }

        /* Search dropdown */
        .app-search {
            display: none;
            right: 0;
            left: auto;
            box-shadow: 0 8px 24px rgba(2,6,23,.12);
        }

            .app-search.show {
                display: block;
            }

            .app-search .form-control {
                border-color: rgba(2,6,23,.08);
            }

            .app-search .srh-btn {
                color: var(--muted);
                border: none;
                background: none;
            }

        /* ========= Sidebar ========= */
        .left-sidebar, .sidebar-nav ul, .sidebar-nav ul li a {
            background: var(--thead) !important;
        }

        .left-sidebar {
            width: var(--sidebar-open);
            transition: width .25s ease, box-shadow .25s ease;
        }

        .sidebar-item .sidebar-link {
            color: #cbd5e1 !important;
            border-radius: 10px;
            margin: 2px 10px;
            transition: background-color .2s ease, color .2s ease;
        }

            .sidebar-item .sidebar-link:hover {
                background: rgba(139,92,246,.12) !important;
                color: #fff !important;
            }

            .sidebar-item .sidebar-link.active,
            .sidebar-item .sidebar-link[aria-expanded="true"] {
                background: linear-gradient(135deg, var(--accent), var(--accent-600)) !important;
                color: #fff !important;
                box-shadow: 0 8px 22px rgba(139,92,246,.35);
            }

        .sidebar-nav .has-arrow::after {
            border-color: #cbd5e1;
        }

        /* ========= İçerik/Kartlar ========= */
        .page-wrapper {
            background: var(--soft);
            margin-left: var(--sidebar-open); /* FIX: içerik kaydırma */
            transition: margin-left .25s ease, background-color .25s ease;
        }

        .card, .card-hover, .comment-widgets, .todo-widget, .chat-box {
            border: 0;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(2,6,23,.08);
            transition: box-shadow .25s ease, transform .18s ease;
        }

            .card .card-title, .card h4, h5, h6 {
                color: var(--ink);
            }

        .text-muted, .font-light, small {
            color: var(--muted) !important;
        }

        /* ========= Butonlar ========= */
        .btn-success, .btn-cyan, .btn-info, .btn-primary, .btn-danger {
            border: 0;
            color: #fff !important;
            background: linear-gradient(135deg, var(--accent), var(--accent-600));
            box-shadow: 0 8px 22px rgba(139,92,246,.35);
            transition: filter .15s ease, box-shadow .25s ease;
        }

            .btn-success:hover, .btn-cyan:hover, .btn-info:hover, .btn-primary:hover, .btn-danger:hover {
                filter: brightness(0.95);
            }

        /* ========= DataTables başlık & hover ========= */
        table.dataTable thead th {
            background: var(--thead);
            color: var(--thead-text);
        }

        table.dataTable tbody tr:hover {
            background: var(--row-hover);
        }

        .dataTables_wrapper .dt-buttons .btn {
            border-radius: 10px;
        }

        /* ========= Preloader accent ========= */
        .preloader .lds-ripple div {
            border-color: var(--accent) !important;
        }

        .navbar-brand img.light-logo {
            filter: none !important;
        }

        /* ========= MINI SIDEBAR (ikon-only) ========= */
        /* FIX: .mini-sidebar durumunda sadece ikonlar görünsün */
        #main-wrapper.mini-sidebar .left-sidebar {
            width: var(--sidebar-mini);
        }

        #main-wrapper.mini-sidebar .sidebar-nav .hide-menu {
            display: none !important;
        }

        #main-wrapper.mini-sidebar .sidebar-item .sidebar-link {
            justify-content: center;
        }

            #main-wrapper.mini-sidebar .sidebar-item .sidebar-link i {
                margin-right: 0 !important;
            }

        #main-wrapper.mini-sidebar .sidebar-nav .has-arrow::after {
            display: none !important;
        }

        #main-wrapper.mini-sidebar .page-wrapper {
            margin-left: var(--sidebar-mini);
        }

        /* Alt başlıklar ve hover’lar için yumuşaklık */
        .sidebar-nav ul {
            transition: padding .25s ease;
        }
        /* ========= TOPBAR'ı SIDEBAR (#0b1220) ile birebir yap – skin5'i de EZER ========= */

        /* 1) Topbar + içindeki tüm katmanlar (#0b1220) */
        #main-wrapper > header.topbar[data-navbarbg],
        #main-wrapper > header.topbar[data-navbarbg] .top-navbar,
        #main-wrapper > header.topbar[data-navbarbg] .navbar,
        #main-wrapper > header.topbar[data-navbarbg] .navbar-collapse,
        #main-wrapper > header.topbar .navbar-header[data-logobg] {
            background-color: #0b1220 !important;
            background-image: none !important; /* gradyan/skin görsellerini kapat */
        }

        /* 2) Özellikle skin5 kurallarını geçersiz kıl (yüksek özgülük için class tekrarları) */
        header.topbar.topbar[data-navbarbg="skin5"],
        header.topbar.topbar[data-navbarbg="skin5"] .navbar,
        header.topbar.topbar[data-navbarbg="skin5"] .navbar-collapse,
        header.topbar .navbar-header.navbar-header[data-logobg="skin5"] {
            background-color: #0b1220 !important;
            background-image: none !important;
        }

        /* 3) Üst bardaki metin/ikon renkleri: sidebar paletiyle aynı */
        header.topbar .navbar-brand,
        header.topbar .navbar .navbar-nav .nav-link,
        header.topbar .navbar .navbar-nav .nav-link i,
        header.topbar .navbar .navbar-toggler,
        header.topbar .mdi,
        header.topbar .ti-menu,
        header.topbar .ti-close,
        header.topbar .ti-more,
        header.topbar .fa {
            color: #cbd5e1 !important; /* sidebar metin rengi */
            fill: #cbd5e1 !important;
        }

            header.topbar .navbar .navbar-nav .nav-link:hover {
                color: #fff !important;
            }

        /* 4) Dropdown ve arama kutusu da aynı koyu zeminde */
        header.topbar .dropdown-menu {
            background: #0b1220 !important;
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(2,6,23,.35);
        }

        header.topbar .dropdown-item {
            color: #cbd5e1 !important;
        }

            header.topbar .dropdown-item:hover {
                background: rgba(255,255,255,.08) !important;
            }

        header.topbar .search-box .app-search {
            background: #0b1220 !important;
            box-shadow: 0 8px 24px rgba(2,6,23,.45) !important;
        }

            header.topbar .search-box .app-search .form-control {
                background: rgba(255,255,255,.06);
                color: #e5e7eb;
                border-color: rgba(255,255,255,.12);
            }

                header.topbar .search-box .app-search .form-control::placeholder {
                    color: #94a3b8;
                }

            header.topbar .search-box .app-search .srh-btn {
                color: #cbd5e1 !important;
            }

        /* 5) Navbar arka planını transparan tut (üstteki topbar rengi görünsün) */
        header.topbar .navbar {
            background: transparent !important;
        }

        :root {
            --topbar-h: 64px;
        }
        /* topbar yüksekliği; gerekiyorsa 56px yap */

        @@media (max-width: 991.98px) {
            /* İçerik sola kaymasın */
            .page-wrapper

        {
            margin-left: 0 !important;
        }

        /* Sidebar’ı ekrandan dışarıda başlat */
        .left-sidebar {
            position: fixed !important;
            top: var(--topbar-h);
            bottom: 0;
            left: 0;
            width: var(--sidebar-open,240px) !important;
            transform: translateX(-100%);
            transition: transform .2s ease;
            z-index: 1060; /* topbar üstünde */
        }

        /* .show-sidebar geldiğinde içeri kaydır */
        #main-wrapper.show-sidebar .left-sidebar {
            transform: translateX(0);
        }

        /* Arka plan karartma */
        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.35);
            opacity: 0;
            pointer-events: none;
            transition: opacity .2s ease;
            z-index: 1055;
        }

        #main-wrapper.show-sidebar + .sidebar-backdrop,
        #main-wrapper.show-sidebar .sidebar-backdrop {
            opacity: 1;
            pointer-events: auto;
        }

        }

        .topbar .btn.btn-solid {
            color: #e5e7eb;
        }

            .topbar .btn.btn-solid:hover {
                background: rgba(255,255,255,.08);
            }

        .topbar .btn.btn-success {
            background: #0b1220;
            border: 1px solid rgba(255,255,255,.15);
        }

            .topbar .btn.btn-success:hover {
                filter: brightness(1.08);
            }
        /* Topbar içeriğini dikey ortala */
        header.topbar .navbar,
        header.topbar .navbar .navbar-collapse,
        header.topbar .navbar .navbar-nav {
            align-items: center !important;
        }

        /* Butonlar ezilmesin / rahat nefes alsın */
        .topbar-tools .btn {
            line-height: 1.25rem;
            padding: .45rem .75rem;
        }

        /* Mobilde iki butonun solda/sağda yerleşimi zaten justify-content-between ile */
        /* Topbardaki butonların etkileşimi: “bir ton açığı” */
        .topbar .btn {
            box-shadow: none !important;
            transition: filter .15s ease, box-shadow .15s ease, transform .12s ease;
        }

            .topbar .btn:hover {
                filter: brightness(1.06);
            }

            .topbar .btn:active, .topbar .btn:focus {
                filter: brightness(1.10);
                box-shadow: none !important;
            }

        /* Sadece ISBN butonu hover’da gölge alsın */
        .topbar .btn-isbn {
            background: #0b1220 !important;
            border: 1px solid rgba(255,255,255,.15) !important;
            box-shadow: none !important;
        }

            .topbar .btn-isbn:hover {
                box-shadow: 0 8px 22px rgba(11,18,32,.35) !important;
            }
        /* Tara butonunda border/efekt sabitleme */
        .topbar .btn-isbn {
            background: #0b1220 !important;
            border: none !important; /* beyaz border kalksın */
            color: #e5e7eb !important;
            box-shadow: none !important;
        }

            .topbar .btn-isbn:hover,
            .topbar .btn-isbn:focus,
            .topbar .btn-isbn:active {
                background: #0b1220 !important; /* tıklayınca beyaz efekt oluşmasın */
                color: #e5e7eb !important; /* text rengi değişmesin */
                filter: none !important;
                box-shadow: none !important;
                outline: none !important;
            }

        /* Eğer Material Waves eklentisi halen bağlıysa dalga efektini öldür */
        .waves-effect {
            position: static !important;
        }

        .waves-ripple {
            display: none !important;
        }
        /* === TOPBAR DÜZGÜN BUTON SETİ (BORDER YOK, YAZI KAYBOLMAZ) === */
        header.topbar {
            background: #0b1220 !important;
        }

            header.topbar .navbar {
                background: transparent !important;
            }

            /* Tüm topbar butonlarının sıfırlanması */
            header.topbar .btn,
            header.topbar .nav-link {
                border: none !important;
                box-shadow: none !important;
                color: #e5e7eb !important;
                background: transparent;
                transition: background .12s ease, filter .12s ease, transform .1s ease;
            }

            /* "Ghost" tip (ikonlu metin butonları – arama/çıkış/Google Books) */
            header.topbar .btn-ghost,
            header.topbar .nav-link {
                background: transparent !important;
                color: #e5e7eb !important;
            }

                header.topbar .btn-ghost:hover,
                header.topbar .nav-link:hover {
                    background: rgba(255,255,255,.08) !important;
                    color: #ffffff !important;
                }

                header.topbar .btn-ghost:active,
                header.topbar .btn-ghost:focus,
                header.topbar .nav-link:active,
                header.topbar .nav-link:focus {
                    background: rgba(255,255,255,.12) !important;
                    color: #ffffff !important;
                    outline: none !important;
                }

            /* "Solid" tip (vurgulu buton – ISBN ve istersen telefon için) */
            header.topbar .btn-solid,
            header.topbar .btn-isbn,
            header.topbar .btn-phone-scan {
                background: #1f262d !important;
                color: #e5e7eb !important;
                border: none !important;
                border-radius: .5rem;
            }

                header.topbar .btn-solid:hover,
                header.topbar .btn-isbn:hover,
                header.topbar .btn-phone-scan:hover {
                    background: #232b33 !important;
                    color: #ffffff !important;
                }

                header.topbar .btn-solid:active,
                header.topbar .btn-isbn:active,
                header.topbar .btn-phone-scan:active,
                header.topbar .btn-solid:focus,
                header.topbar .btn-isbn:focus,
                header.topbar .btn-phone-scan:focus {
                    background: #232b33 !important;
                    color: #ffffff !important;
                    outline: none !important;
                }

            /* Arama açılan kutu topbar temasına uysun */
            header.topbar .app-search {
                background: #0b1220 !important;
                border: 1px solid rgba(255,255,255,.1) !important;
                box-shadow: 0 8px 24px rgba(2,6,23,.45) !important;
            }

                header.topbar .app-search .form-control {
                    background: rgba(255,255,255,.06) !important;
                    color: #e5e7eb !important;
                    border-color: rgba(255,255,255,.12) !important;
                }

                    header.topbar .app-search .form-control::placeholder {
                        color: #94a3b8 !important;
                    }

                header.topbar .app-search .srh-btn {
                    color: #cbd5e1 !important;
                }

            /* Waves eklentisinden gelen ripple/border’ı tamamen öldür */
            header.topbar .waves-effect,
            header.topbar .waves-light {
                position: static !important;
            }

            header.topbar .waves-ripple {
                display: none !important;
            }

            /* Kollara takılan bootstrap outline stillerini tamamen geçersiz kıl */
            header.topbar .btn-solid {
                background: transparent !important;
                color: #e5e7eb !important;
                border: none !important;
            }

                header.topbar .btn-solid:hover {
                    background: rgba(255,255,255,.08) !important;
                }

            /* İkon/metin renkleri */
            header.topbar .navbar .navbar-nav .nav-link i,
            header.topbar .mdi, header.topbar .ti-search, header.topbar .fa {
                color: inherit !important;
                fill: currentColor !important;
            }

    </style>
</head>

<body>
    <!-- ============================================================== -->
    <!-- Preloader - style you can find in spinners.css -->
    <!-- ============================================================== -->
    <div class="preloader">
        <div class="lds-ripple">
            <div class="lds-pos"></div>
            <div class="lds-pos"></div>
        </div>
    </div>
    <!-- ============================================================== -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <div id="main-wrapper">
        <!-- ============================================================== -->
        <!-- Topbar header - style you can find in pages.scss -->
        <!-- ============================================================== -->
        <header class="topbar" data-navbarbg="skin5">
            <!-- FIX: navbar-light kullanıldı ki metinler görünür olsun -->
            <nav class="navbar top-navbar navbar-expand-md navbar-dark"><!-- was navbar-light -->
                <!-- was navbar-dark -->
                <div class="navbar-header" data-logobg="skin5">
                    <!-- This is for the sidebar toggle which is visible on mobile only -->
                    <a class="nav-toggler waves-effect waves-light d-block d-md-none" href="javascript:void(0)"><i class="ti-menu ti-close"></i></a>
                    <!-- ============================================================== -->
                    <!-- Logo -->
                    <!-- ============================================================== -->
                    <!-- FIX: 404/başlığa tıklama → site köküne yönlendirme -->
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <!-- Logo icon -->
                        <b class="logo-icon p-l-10">
                            <!--You can put here icon as well // <i class="wi wi-sunset"></i> //-->
                            <!-- Dark Logo icon -->
                            <img src="~/matrix-admin/assets/images/logo-icon.png" alt="homepage" class="light-logo" />
                        </b>
                        <!--End Logo icon -->
                        <!-- Logo text -->
                        <span class="logo-text">
                            <!-- dark Logo text -->
                            <!-- FIX: logonuz beyazsa açık zeminde görünmeyebilir; mümkünse koyu versiyon ekleyin -->
                            <!-- <img src="~/matrix-admin/assets/images/logo-text-dark.png" alt="homepage" class="dark-logo" /> -->
                            <img src="~/matrix-admin/assets/images/logo-text.png" alt="homepage" class="light-logo" />
                        </span>
                        <!-- Logo icon -->
                        <!-- <b class="logo-icon"> -->
                        <!--You can put here icon as well // <i class="wi wi-sunset"></i> //-->
                        <!-- Dark Logo icon -->
                        <!-- <img src="assets/images/logo-text.png" alt="homepage" class="light-logo" /> -->
                        <!-- </b> -->
                        <!--End Logo icon -->
                    </a>
                    <!-- ============================================================== -->
                    <!-- End Logo -->
                    <!-- ============================================================== -->
                    <!-- ============================================================== -->
                    <!-- Toggle which is visible on mobile only -->
                    <!-- ============================================================== -->
                    <a class="topbartoggler d-block d-md-none waves-effect waves-light" href="javascript:void(0)"
                       data-toggle="collapse" data-target="#navbarSupportedContent"
                       aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><i class="ti-more"></i></a>
                </div>
                <!-- ============================================================== -->
                <!-- End Logo -->
                <!-- ============================================================== -->

                <div class="navbar-collapse collapse" id="navbarSupportedContent" data-navbarbg="skin5">

                    <ul class="navbar-nav mr-auto align-items-center">
                        <li class="nav-item d-none d-md-block">
                            <a class="nav-link sidebartoggler" href="javascript:void(0)" data-sidebartype="mini-sidebar">
                                <i class="mdi mdi-menu font-24"></i>
                            </a>
                        </li>

                        <!-- Telefondan Tara (solda) -->
                        <li class="nav-item d-none d-md-block">
                            <button type="button" class="btn btn-phone-scan mx-1" onclick="openPhoneScan()">
                                <i class="fas fa-mobile-alt mr-1"></i> Telefondan Tara
                            </button>
                        </li>

                        <!-- ARAMA İKONU: TELEFONDAN TARA’NIN HEMEN YANINA -->
                        <li class="nav-item search-box d-none d-md-block">
                            <a class="nav-link" href="javascript:void(0)">
                                <i class="ti-search"></i>
                            </a>
                            <form class="app-search position-absolute p-2 rounded" method="get" asp-controller="Search" asp-action="Index">
                                <input type="text" class="form-control" placeholder="Search &amp; enter" name="query">
                                <button type="submit" class="srh-btn"><i class="ti-search"></i></button>
                            </form>
                        </li>

                        <!-- Mobilde iki buton yan yana -->
                        <li class="nav-item d-flex d-md-none w-100 px-2">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <button type="button" class="btn btn-phone-scan" onclick="openPhoneScan()">
                                    <i class="fas fa-mobile-alt mr-1"></i> Telefondan Tara
                                </button>
                                <button type="button" class="btn btn-isbn" onclick="openIsbnModal()">
                                    <i class="fas fa-barcode mr-1"></i> ISBN Tara
                                </button>
                            </div>
                        </li>
                    </ul>

                   <ul class="navbar-nav ml-auto align-items-center topbar-tools">
    <li class="nav-item d-none d-md-block">
        <button id="searchGoogleBooksBtnTop" type="button" class="btn btn-ghost">
            <i class="fas fa-search mr-1"></i> Google Books’ta Ara
        </button>
    </li>
    <li class="nav-item d-none d-md-block">
        <button type="button" class="btn btn-solid mx-1 btn-isbn" onclick="openIsbnModal()">
            <i class="fas fa-barcode mr-1"></i> ISBN Tara
        </button>
    </li>
    <li class="nav-item ml-2">
        <form asp-controller="Auth" asp-action="Logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-ghost">
                <i class="mdi mdi-logout-variant mr-1"></i> Çıkış Yap
            </button>
        </form>
    </li>
</ul>
                </div>

            </nav>
        </header>
        <partial name="_IsbnScannerPartial" />

        <!-- Telefondan Tara Modal (ARTIK LAYOUT’TA) -->
        <div id="phoneScanModal" class="modal fade" tabindex="-1">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content p-3 text-center">
