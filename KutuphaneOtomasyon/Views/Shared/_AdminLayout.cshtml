    @RenderSection("Scripts", required: false)
    <script>
        // --- ISBN Modal kontrolü (Html5QrcodeScanner lazily init) ---
        let __isbnScanner = null;
        let __isbnScannerReady = false;

        function openIsbnModal() {
          const $m = $('#isbnModal');
          $m.show();

          // ilk açılışta scanner'ı oluştur
          if (!__isbnScanner) {
            const config = {
              fps: 10,
              qrbox: 250,
              formatsToSupport: [ Html5QrcodeSupportedFormats.EAN_13 ],
              showTorchButtonIfSupported: true,
              rememberLastUsedCamera: true
            };
            __isbnScanner = new Html5QrcodeScanner('isbnReader', config, /* verbose */ false);

            __isbnScanner.render(onIsbnDecoded, onIsbnScanFailure);
            __isbnScannerReady = true;
          }
        }

        function onIsbnDecoded(decodedText, decodedResult) {
          // decodedText: ISBN/EAN-13
          const isbn = (decodedText || '').replace(/[^0-9Xx]/g,'');
          if (!isbn) return;

          // İstersen burada direkt bir sayfaya yönlendirebilirsin:
          // window.location.href = '/Book?isbn=' + isbn;

          // Örnek: Google Books modalını ISBN ile açmak istersen
          if (typeof searchBooks === 'function') {
            $('#googleBooksModal').modal('show');
            $('#googleBooksSearchForm input[name="query"]').val(isbn);
            $('#googleBooksSearchForm').trigger('submit');
          }

          closeIsbnModal(); // tara kapat
        }

        function onIsbnScanFailure(err) {
          // istemiyorsan sessiz geç
          // console.debug(err);
        }

        function closeIsbnModal() {
          const $m = $('#isbnModal');
          try {
            // Html5QrcodeScanner kendi kontrolünü kapatır, modalı biz gizleriz
            // (render edilmişse UI kendini dispose eder)
          } catch(e) {}
          $m.hide();
        }

        // Kapat butonu id’si varsa bağla (partial’ın içinde var)
        $(document).on('click', '#btnIsbnClose', closeIsbnModal);
        // modal arka plana tıklayınca kapat
        $(document).on('click', function(e){
          if ($(e.target).is('#isbnModal')) closeIsbnModal();
        });

        // --- Telefondan Tara: QR üret ve modalı aç ---
        function openPhoneScan() {
          const $m = $('#phoneScanModal');
          $m.modal('show');

          // QR alanını temizle ve yeniden çiz
          const el = document.getElementById('scanQr');
          el.innerHTML = '';

          // Buraya telefonun açacağı URL'i yaz.
          // Varsa kendi endpoint'inle değiştir: örn '/Book/MobileScan'
          const url = window.location.origin + '/Book/MobileScan';

          new QRCode(el, { text: url, width: 160, height: 160 });
        }
    </script>
